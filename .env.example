# Redis-compatible client for the independent support Valkey instance.
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_DB=0

BOT_MESSAGES_PER_MINUTE=30
BOT_TOPICS_PER_MINUTE=10
